# OwnMediaHost Frontend Environment Configuration Example

# Backend API base URL
# In development, Vite proxies /api to VITE_BACKEND_URL.
# In production, Nginx proxies /api/v1 to the backend service.
VITE_API_BASE_URL=/api/v1

# Backend server URL (used for Vite reverse proxy and media links)
VITE_BACKEND_URL=http://127.0.0.1:8080

# Application metadata
VITE_APP_NAME=OwnMediaHost
VITE_APP_VERSION=0.1.0

# Frontend development server port
VITE_PORT=5173
