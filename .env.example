# OwnMediaHost Environment Configuration
# Copy this file to .env and adjust variables as necessary.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5002

# Database
# Local SQLite database (WAL mode, fast & standalone)
DATABASE_URL=sqlite://storage/database/media.db?mode=rwc

# Storage paths
MEDIA_ROOT=./storage
PUBLIC_BASE_URL=http://localhost:5002

# Upload limits (in bytes)
MAX_IMAGE_SIZE=52428800         # 50 MB
MAX_VIDEO_SIZE=5368709120       # 5 GB
DEFAULT_CHUNK_SIZE=10485760     # 10 MB per chunk for resumable uploads

# Cryptography & Secrets (Generate strong 32+ byte strings in production)
JWT_SECRET=super_secret_jwt_key_change_me_in_production_32_chars_min!
COOKIE_SECRET=super_secret_cookie_key_change_me_in_production_32!
API_KEY_PEPPER=super_secret_pepper_change_me_in_production_32_chars!
TRANSFORM_SIGNING_KEY=secret_transform_hmac_signing_key_32_chars_min!
PRIVATE_URL_SIGNING_KEY=secret_private_url_hmac_signing_key_32_chars!

# Initial Admin Credentials (Provisioned on first startup if no user exists)
ADMIN_EMAIL=admin@ownmediahost.local
ADMIN_PASSWORD=AdminSecurePass2026!

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Image Transformations Limits
MAX_TRANSFORM_WIDTH=4096
MAX_TRANSFORM_HEIGHT=4096
MAX_TRANSFORM_PIXELS=16777216   # 16 MP max output
ALLOWED_TRANSFORM_FORMATS=jpeg,png,webp,gif

# Optional external imgproxy URL (leave empty to use built-in high-performance native Rust SIMD image engine)
IMGPROXY_URL=
